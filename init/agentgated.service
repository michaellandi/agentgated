[Unit]
Description=agentgated - egress control daemon for AI agents
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/agentgated -config /etc/agentgated/agentgated.yaml
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
